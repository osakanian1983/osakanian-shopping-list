//@version=5
indicator("3分足デイトレ ゼロ遅延レベルシグナル", shorttitle="3min ZeroLag Signal", overlay=true)

// ========================================================
// 3分足デイトレード用 売買タイミング表示インジケーター(ゼロ遅延版)
//
// これまでの版は全て「確定を待ってから判定する」設計だった
// (ピボット確定に左右N本待つ、ローソク足パターンの完成を待つ等)。
// これはデイトレの「今この瞬間の値動きで判断したい」という要求と
// 根本的に矛盾する。
//
// 今回は「確定待ちが一切不要な情報」だけを使う。
//   ・本日のセッション高値/安値 … 今の値でその場で決まる(待ち時間ゼロ)
//   ・前日の高値/安値/終値      … 既に確定済み、いつでも使える
//   ・VWAP                      … 元々リアルタイム
//
// シグナルは「今確定した1本の足」を候補として拾い、次の1本で継続したかだけ
// 追加確認する(それ以上は待たない)。1本だけの判定だとヒゲの単発反応(ノイズ)
// まで拾ってしまうため、最小限の確認を挟んでいる。
//   ・反発: そのレベルにヒゲでタッチし、実体は反対側で終わった候補足の後、
//     次の足がさらに同じ方向に閉じたら採用
//   ・ブレイク: そのレベルを実体の強い足で突破した候補足の後、
//     次の足がさらに同じ方向に閉じたら採用
// ========================================================

grpLevels = "参照レベル(確定待ちなし)"
useSessionLevels = input.bool(true, "本日の高値/安値を使う", group=grpLevels)
usePrevDayLevels = input.bool(true, "前日の高値/安値を使う", group=grpLevels)
useVwapLevel = input.bool(true, "VWAPを使う", group=grpLevels)
showLevelLines = input.bool(true, "レベルをチャートに表示する", group=grpLevels)

grpSignal = "シグナル条件"
useRejectSignals = input.bool(true, "節目での反発(タッチ&リバース)シグナルを使う", group=grpSignal)
useBreakSignals = input.bool(true, "節目のブレイク(勢いで抜けた)シグナルを使う", group=grpSignal)
minBodyRatio = input.float(0.5, "ブレイク採用に必要な実体の強さ(レンジに対する比率)", minval=0.1, maxval=0.95, step=0.05, group=grpSignal,
     tooltip="ブレイク(勢いで抜けた)シグナルだけに適用。反発シグナルには適用されません。")

grpVol = "出来高フィルター"
useVolFilter = input.bool(true, "出来高フィルターを使用する", group=grpVol)
volMaLen = input.int(20, "出来高平均期間", minval=1, group=grpVol)
volMult = input.float(1.0, "出来高がこの倍率以上で採用", minval=0.1, step=0.1, group=grpVol)

grpRisk = "損切り/利確ライン(トレードプラン)"
showTradePlan = input.bool(true, "シグナル発生時に損切り/利確ラインを表示する", group=grpRisk,
     tooltip="狙いは「シグナルを当てる」ことではなく、当たった時に何倍獲れて外れた時に何を失うかを事前に見えるようにすることです。")
atrBufferMult = input.float(0.3, "損切りをレベルからどれだけ離すか(ATRの倍率)", minval=0.05, step=0.05, group=grpRisk)
rewardMultiple = input.float(1.5, "次のレベルが使えない場合の利確目標(リスクの何倍か)", minval=0.5, step=0.1, group=grpRisk)
planLineBars = input.int(20, "損切り/利確ラインを右に伸ばす本数", minval=5, group=grpRisk)

// ---------- 参照レベルの計算(すべて確定待ちゼロ) ----------
atrVal = ta.atr(14)

volMa = ta.sma(volume, volMaLen)
volOk = not useVolFilter or volume >= volMa * volMult

// 本日のセッション高値/安値をリアルタイムに更新
newDay = ta.change(time("D")) != 0

var float dayHigh = na
var float dayLow = na
var float prevDayHigh = na
var float prevDayLow = na

if newDay or na(dayHigh)
    prevDayHigh := dayHigh
    prevDayLow := dayLow
    dayHigh := high
    dayLow := low
else
    dayHigh := math.max(dayHigh, high)
    dayLow := math.min(dayLow, low)

// [1]を使うのは、今の足自身が新高値/新安値を作った場合に
// 「レベルにタッチした」判定が常に真になってしまう(トートロジー)のを防ぐため
sessionHighLevel = useSessionLevels ? dayHigh[1] : na
sessionLowLevel = useSessionLevels ? dayLow[1] : na
prevHighLevel = usePrevDayLevels ? prevDayHigh : na
prevLowLevel = usePrevDayLevels ? prevDayLow : na
vwapVal = ta.vwap(hlc3)
vwapLevel = useVwapLevel ? vwapVal : na

// ---------- シグナル判定(今確定した1本の足だけで判定) ----------
bodyRatio = math.abs(close - open) / math.max(high - low, syminfo.mintick)
strongBull = close > open and bodyRatio >= minBodyRatio
strongBear = close < open and bodyRatio >= minBodyRatio

supportReject(level) =>
    useRejectSignals and not na(level) and low <= level and close > level and close > open

resistanceReject(level) =>
    useRejectSignals and not na(level) and high >= level and close < level and close < open

bullBreak(level) =>
    useBreakSignals and not na(level) and ta.crossover(close, level) and strongBull

bearBreak(level) =>
    useBreakSignals and not na(level) and ta.crossunder(close, level) and strongBear

// ---------- 候補足の判定(まだ確定シグナルではない) ----------
buySessionLowRejectCand = supportReject(sessionLowLevel)
buySessionHighBreakCand = bullBreak(sessionHighLevel)
buyPrevLowRejectCand = supportReject(prevLowLevel)
buyPrevHighBreakCand = bullBreak(prevHighLevel)
buyVwapRejectCand = supportReject(vwapLevel)

sellSessionHighRejectCand = resistanceReject(sessionHighLevel)
sellSessionLowBreakCand = bearBreak(sessionLowLevel)
sellPrevHighRejectCand = resistanceReject(prevHighLevel)
sellPrevLowBreakCand = bearBreak(prevLowLevel)
sellVwapRejectCand = resistanceReject(vwapLevel)

// ---------- 次の1本での継続確認(単発ヒゲのノイズを除外) ----------
buyContinues = close > close[1]
sellContinues = close < close[1]

buySessionLowReject = buySessionLowRejectCand[1] and buyContinues
buySessionHighBreak = buySessionHighBreakCand[1] and buyContinues
buyPrevLowReject = buyPrevLowRejectCand[1] and buyContinues
buyPrevHighBreak = buyPrevHighBreakCand[1] and buyContinues
buyVwapReject = buyVwapRejectCand[1] and buyContinues

sellSessionHighReject = sellSessionHighRejectCand[1] and sellContinues
sellSessionLowBreak = sellSessionLowBreakCand[1] and sellContinues
sellPrevHighReject = sellPrevHighRejectCand[1] and sellContinues
sellPrevLowBreak = sellPrevLowBreakCand[1] and sellContinues
sellVwapReject = sellVwapRejectCand[1] and sellContinues

buySignal = volOk and (buySessionLowReject or buySessionHighBreak or buyPrevLowReject or buyPrevHighBreak or buyVwapReject)
sellSignal = volOk and (sellSessionHighReject or sellSessionLowBreak or sellPrevHighReject or sellPrevLowBreak or sellVwapReject)

// ---------- 描画: 参照レベル ----------
plot(showLevelLines and useSessionLevels ? sessionHighLevel : na, "本日高値", color=color.new(color.red, 20), style=plot.style_linebr, linewidth=1)
plot(showLevelLines and useSessionLevels ? sessionLowLevel : na, "本日安値", color=color.new(color.lime, 20), style=plot.style_linebr, linewidth=1)
plot(showLevelLines and usePrevDayLevels ? prevHighLevel : na, "前日高値", color=color.new(color.red, 50), style=plot.style_linebr, linewidth=1)
plot(showLevelLines and usePrevDayLevels ? prevLowLevel : na, "前日安値", color=color.new(color.lime, 50), style=plot.style_linebr, linewidth=1)
plot(showLevelLines and useVwapLevel ? vwapVal : na, "VWAP", color=color.new(color.purple, 0), linewidth=2)

// ---------- 描画: シグナル ----------
plotshape(buySessionLowReject or buyPrevLowReject or buyVwapReject, title="反発買い", style=shape.triangleup, location=location.belowbar,
     color=color.new(color.green, 0), size=size.small, text="反発買")
plotshape(buySessionHighBreak or buyPrevHighBreak, title="ブレイク買い", style=shape.arrowup, location=location.belowbar,
     color=color.new(color.teal, 0), size=size.small, text="抜け買")
plotshape(sellSessionHighReject or sellPrevHighReject or sellVwapReject, title="反発売り", style=shape.triangledown, location=location.abovebar,
     color=color.new(color.red, 0), size=size.small, text="反発売")
plotshape(sellSessionLowBreak or sellPrevLowBreak, title="ブレイク売り", style=shape.arrowdown, location=location.abovebar,
     color=color.new(color.maroon, 0), size=size.small, text="抜け売")

// ---------- 損切り/利確ライン(トレードプラン) ----------
// 損切り: シグナルの根拠になったレベルのすぐ外側(=そのレベルが否定されたら撤退)
// 利確目標: 反対側の直近レベル(本日高安→前日高安→VWAPの優先順で最初に見つかったもの)。
//          使えるレベルがなければリスクの倍数を目安として表示
// 最新のシグナル1件分だけを表示し、新しいシグナルが出ると前のものと置き換わる
var line slLineBuy = na
var line tpLineBuy = na
var label planLabelBuy = na
var line slLineSell = na
var line tpLineSell = na
var label planLabelSell = na

if buySignal and showTradePlan
    buyLevelUsed = buySessionLowReject ? sessionLowLevel : buySessionHighBreak ? sessionHighLevel : buyPrevLowReject ? prevLowLevel : buyPrevHighBreak ? prevHighLevel : vwapLevel
    stopLossBuy = buyLevelUsed - atrVal * atrBufferMult
    riskBuy = math.max(close - stopLossBuy, atrVal * 0.1)
    targetBuy = (not na(sessionHighLevel) and sessionHighLevel > close) ? sessionHighLevel : (not na(prevHighLevel) and prevHighLevel > close) ? prevHighLevel : (not na(vwapLevel) and vwapLevel > close) ? vwapLevel : close + riskBuy * rewardMultiple
    rrBuy = (targetBuy - close) / riskBuy

    line.delete(slLineBuy)
    line.delete(tpLineBuy)
    label.delete(planLabelBuy)
    slLineBuy := line.new(bar_index, stopLossBuy, bar_index + planLineBars, stopLossBuy, color=color.new(color.red, 0), style=line.style_dotted, width=1)
    tpLineBuy := line.new(bar_index, targetBuy, bar_index + planLineBars, targetBuy, color=color.new(color.blue, 0), style=line.style_dotted, width=1)
    planLabelBuy := label.new(bar_index, close, "SL " + str.tostring(stopLossBuy, format.mintick) + "\nTP " + str.tostring(targetBuy, format.mintick) + "\nRR " + str.tostring(rrBuy, "#.##"),
         yloc=yloc.belowbar, style=label.style_label_up, color=color.new(color.green, 85), textcolor=color.new(color.green, 0), size=size.small)

if sellSignal and showTradePlan
    sellLevelUsed = sellSessionHighReject ? sessionHighLevel : sellSessionLowBreak ? sessionLowLevel : sellPrevHighReject ? prevHighLevel : sellPrevLowBreak ? prevLowLevel : vwapLevel
    stopLossSell = sellLevelUsed + atrVal * atrBufferMult
    riskSell = math.max(stopLossSell - close, atrVal * 0.1)
    targetSell = (not na(sessionLowLevel) and sessionLowLevel < close) ? sessionLowLevel : (not na(prevLowLevel) and prevLowLevel < close) ? prevLowLevel : (not na(vwapLevel) and vwapLevel < close) ? vwapLevel : close - riskSell * rewardMultiple
    rrSell = (close - targetSell) / riskSell

    line.delete(slLineSell)
    line.delete(tpLineSell)
    label.delete(planLabelSell)
    slLineSell := line.new(bar_index, stopLossSell, bar_index + planLineBars, stopLossSell, color=color.new(color.red, 0), style=line.style_dotted, width=1)
    tpLineSell := line.new(bar_index, targetSell, bar_index + planLineBars, targetSell, color=color.new(color.blue, 0), style=line.style_dotted, width=1)
    planLabelSell := label.new(bar_index, close, "SL " + str.tostring(stopLossSell, format.mintick) + "\nTP " + str.tostring(targetSell, format.mintick) + "\nRR " + str.tostring(rrSell, "#.##"),
         yloc=yloc.abovebar, style=label.style_label_down, color=color.new(color.red, 85), textcolor=color.new(color.red, 0), size=size.small)

// ---------- アラート ----------
alertcondition(buySignal, title="買いシグナル発生", message="ゼロ遅延レベル: 買いシグナル発生(反発またはブレイク)")
alertcondition(sellSignal, title="売りシグナル発生", message="ゼロ遅延レベル: 売りシグナル発生(反発またはブレイク)")
