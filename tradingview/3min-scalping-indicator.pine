//@version=5
indicator("3分足デイトレ 売買タイミング", shorttitle="3min Signal", overlay=true)

// ========================================================
// 3分足デイトレード用 売買タイミング表示インジケーター
//
// ロジック概要:
//   1. EMA(短期)とEMA(長期)のゴールデンクロス/デッドクロスを起点に
//      「買い候補 / 売り候補」を判定
//   2. VWAPをトレンドフィルターとして使用
//      (VWAPより上でのみ買いシグナル、下でのみ売りシグナルを採用)
//   3. RSIで高値掴み・安値掴みを避けるフィルターをかける
//   4. 出来高が直近平均を上回っているかを確認フィルターとして追加
//   5. 上位足(既定15分足)のEMAトレンド方向をスコアに加味
//   2〜5はAND(全部必須)ではなく「4条件中いくつクリアしたか」のスコア制。
//   しきい値(既定3/4)以上ならEMAクロスの足で「確定シグナル」として矢印+アラート。
//   しきい値未満でもEMAクロス自体は発生していれば「参考シグナル」として薄く表示可能
//   (だましを減らすほどシグナル数は減るため、しきい値で好みに調整する)
//
//   6. 反発(リバーサル)シグナル: EMAクロスは底/天井を打ってから確定するため
//      構造的に遅れる。ストキャスティクスが売られすぎ/買われすぎ圏で交差した
//      時点をより早い反発の目安として、EMAクロス系とは別に「反発買/反発売」
//      (ひし形)で表示する。上位足トレンドが追いつく前の早い転換を拾うための
//      シグナルなので、既定では上位足フィルターの対象外にしている。
// ========================================================

// ---------- 入力パラメータ ----------
grpEma = "移動平均線 (トレンド判定)"
emaFastLen = input.int(9, "EMA 短期", minval=1, group=grpEma)
emaSlowLen = input.int(21, "EMA 長期", minval=1, group=grpEma)

grpVwap = "VWAPフィルター"
useVwapFilter = input.bool(true, "VWAPを買い/売りのフィルターに使用する", group=grpVwap)

grpRsi = "RSIフィルター"
useRsiFilter = input.bool(true, "RSIフィルターを使用する", group=grpRsi)
rsiLen = input.int(14, "RSI期間", minval=1, group=grpRsi)
rsiOverbought = input.int(70, "RSI 買われすぎ水準(この上での新規買いは見送り)", minval=50, maxval=100, group=grpRsi)
rsiOversold = input.int(30, "RSI 売られすぎ水準(この下での新規売りは見送り)", minval=0, maxval=50, group=grpRsi)

grpVol = "出来高フィルター"
useVolFilter = input.bool(true, "出来高フィルターを使用する", group=grpVol)
volMaLen = input.int(20, "出来高平均期間", minval=1, group=grpVol)
volMult = input.float(1.0, "出来高がこの倍率以上で採用", minval=0.1, step=0.1, group=grpVol)

grpSession = "取引時間帯フィルター (任意)"
useSessionFilter = input.bool(false, "取引時間帯を限定する", group=grpSession)
sessionTime = input.session("0900-1130", "取引時間帯", group=grpSession)

grpHtf = "上位足トレンドフィルター"
useHtfFilter = input.bool(true, "上位足のトレンド方向をスコアに含める", group=grpHtf)
htfTimeframe = input.timeframe("15", "上位足の時間足", group=grpHtf)
htfEmaFastLen = input.int(9, "上位足EMA短期", minval=1, group=grpHtf)
htfEmaSlowLen = input.int(21, "上位足EMA長期", minval=1, group=grpHtf)
showHtfLabel = input.bool(true, "上位足トレンドをチャート右上に表示する", group=grpHtf)

grpScore = "シグナルの厳しさ (だまし vs 機会損失の調整)"
minFiltersRequired = input.int(3, "採用に必要な条件数(VWAP/RSI/出来高/上位足のうち何個必要か)", minval=0, maxval=4, group=grpScore,
     tooltip="4=全条件必須(だまし最少・機会損失大) / 0=EMAクロスのみで採用(機会損失最少・だまし多)。上でOFFにしたフィルターは自動的に条件クリア扱いになります。")
showEarlySignal = input.bool(true, "参考シグナル(EMAクロスのみ・未確認)を薄く表示する", group=grpScore)

grpRev = "反発(リバーサル)シグナル - EMAクロスより早いタイミング用"
useReversalSignal = input.bool(true, "ストキャスティクスによる反発シグナルを表示する", group=grpRev,
     tooltip="EMAクロスは底/天井を打ってから確定するため反応が遅れます。売られすぎ/買われすぎ圏でのストキャスティクスの交差を、より早い反発シグナルとして別途表示します。")
stochKLen = input.int(14, "%K期間", minval=1, group=grpRev)
stochDLen = input.int(3, "%D期間", minval=1, group=grpRev)
stochSmooth = input.int(3, "%K平滑化", minval=1, group=grpRev)
stochOversold = input.int(20, "売られすぎ水準", minval=1, maxval=50, group=grpRev)
stochOverbought = input.int(80, "買われすぎ水準", minval=50, maxval=99, group=grpRev)
reversalRequireHtf = input.bool(false, "反発シグナルにも上位足トレンド一致を要求する", group=grpRev,
     tooltip="OFF推奨: 反発シグナルは上位足がまだ反応していない早い段階を狙うためのものです。")

// ---------- 各種計算 ----------
emaFast = ta.ema(close, emaFastLen)
emaSlow = ta.ema(close, emaSlowLen)

vwapVal = ta.vwap(hlc3)

rsiVal = ta.rsi(close, rsiLen)

volMa = ta.sma(volume, volMaLen)
volOk = not useVolFilter or volume >= volMa * volMult

inSession = not useSessionFilter or not na(time(timeframe.period, sessionTime))

// 上位足のEMAトレンド(確定足ベース。lookahead_offで未来参照を防止)
htfEmaFast = request.security(syminfo.tickerid, htfTimeframe, ta.ema(close, htfEmaFastLen), lookahead=barmerge.lookahead_off)
htfEmaSlow = request.security(syminfo.tickerid, htfTimeframe, ta.ema(close, htfEmaSlowLen), lookahead=barmerge.lookahead_off)
htfUptrend = htfEmaFast > htfEmaSlow
htfDowntrend = htfEmaFast < htfEmaSlow
htfOkBuy = not useHtfFilter or htfUptrend
htfOkSell = not useHtfFilter or htfDowntrend
// 選択した上位足が現在のチャート足以下になっていないかの簡易チェック
htfTooLow = timeframe.in_seconds(htfTimeframe) <= timeframe.in_seconds(timeframe.period)

// EMAクロス(トレンド転換の起点)
crossUp = ta.crossover(emaFast, emaSlow)
crossDn = ta.crossunder(emaFast, emaSlow)

// ストキャスティクス(反発シグナル用。EMAクロスより早く底/天井圏の転換を検知)
stochRaw = ta.stoch(close, high, low, stochKLen)
stochK = ta.sma(stochRaw, stochSmooth)
stochD = ta.sma(stochK, stochDLen)

// VWAPフィルター
vwapOkBuy = not useVwapFilter or close > vwapVal
vwapOkSell = not useVwapFilter or close < vwapVal

// RSIフィルター(過熱してる時の新規エントリーを避ける)
rsiOkBuy = not useRsiFilter or rsiVal < rsiOverbought
rsiOkSell = not useRsiFilter or rsiVal > rsiOversold

// ---------- スコア集計 ----------
// VWAP/RSI/出来高/上位足の4条件のうち、いくつクリアしているかを数える
// (フィルターをOFFにした項目は自動的にクリア扱い=常にtrue)
buyScore = (vwapOkBuy ? 1 : 0) + (rsiOkBuy ? 1 : 0) + (volOk ? 1 : 0) + (htfOkBuy ? 1 : 0)
sellScore = (vwapOkSell ? 1 : 0) + (rsiOkSell ? 1 : 0) + (volOk ? 1 : 0) + (htfOkSell ? 1 : 0)

// ---------- 確定シグナル(スコアがしきい値以上) ----------
buySignal = crossUp and inSession and buyScore >= minFiltersRequired
sellSignal = crossDn and inSession and sellScore >= minFiltersRequired

// ---------- 参考シグナル(EMAクロスのみ・条件未確認。早いタイミングの目安) ----------
earlyBuySignal = showEarlySignal and crossUp and inSession and not buySignal
earlySellSignal = showEarlySignal and crossDn and inSession and not sellSignal

// ---------- 反発シグナル(ストキャスティクスが売られすぎ/買われすぎ圏で交差) ----------
// EMAクロスを待たないため、底/天井圏でのより早いタイミングを拾える
reversalBuyRaw = ta.crossover(stochK, stochD) and stochD < stochOversold
reversalSellRaw = ta.crossunder(stochK, stochD) and stochD > stochOverbought
reversalBuySignal = useReversalSignal and reversalBuyRaw and volOk and inSession and (not reversalRequireHtf or htfOkBuy)
reversalSellSignal = useReversalSignal and reversalSellRaw and volOk and inSession and (not reversalRequireHtf or htfOkSell)

// ---------- 描画 ----------
plot(emaFast, "EMA短期", color=color.new(color.orange, 0), linewidth=1)
plot(emaSlow, "EMA長期", color=color.new(color.blue, 0), linewidth=1)
plot(vwapVal, "VWAP", color=color.new(color.purple, 0), linewidth=2)

plotshape(buySignal, title="買いシグナル", style=shape.triangleup, location=location.belowbar,
     color=color.new(color.green, 0), size=size.small, text="買")
plotshape(sellSignal, title="売りシグナル", style=shape.triangledown, location=location.abovebar,
     color=color.new(color.red, 0), size=size.small, text="売")

// 参考シグナル(条件未確認だがEMAクロス自体は発生。だましを含むので薄い表示)
plotshape(earlyBuySignal, title="参考シグナル(買い候補)", style=shape.triangleup, location=location.belowbar,
     color=color.new(color.green, 70), size=size.tiny)
plotshape(earlySellSignal, title="参考シグナル(売り候補)", style=shape.triangledown, location=location.abovebar,
     color=color.new(color.red, 70), size=size.tiny)

// 反発シグナル(ストキャスティクス。EMAクロスより早い底/天井圏のタイミング)
plotshape(reversalBuySignal, title="反発買いシグナル", style=shape.diamond, location=location.belowbar,
     color=color.new(color.aqua, 0), size=size.small, text="反発買")
plotshape(reversalSellSignal, title="反発売りシグナル", style=shape.diamond, location=location.abovebar,
     color=color.new(color.fuchsia, 0), size=size.small, text="反発売")

// トレンド背景色(VWAPに対する上下で軽く色分け)
bgcolor(close > vwapVal ? color.new(color.green, 92) : color.new(color.red, 92), title="VWAPトレンド背景")

// ---------- 上位足トレンド表示ラベル ----------
var table htfTable = table.new(position.top_right, 1, 1)
if showHtfLabel and barstate.islast
    htfText = htfTooLow ? "上位足設定エラー\n(チャート足以下)" : useHtfFilter ? (htfUptrend ? "上位足(" + htfTimeframe + "分): 上昇" : htfDowntrend ? "上位足(" + htfTimeframe + "分): 下降" : "上位足(" + htfTimeframe + "分): 横ばい") : "上位足フィルター: OFF"
    htfColor = htfTooLow ? color.red : htfUptrend ? color.new(color.green, 0) : htfDowntrend ? color.new(color.red, 0) : color.new(color.gray, 0)
    table.cell(htfTable, 0, 0, htfText, text_color=color.white, bgcolor=htfColor)

// ---------- アラート ----------
alertcondition(buySignal, title="買いシグナル発生", message="3分足: 買いシグナル発生 (EMAクロス+VWAP+RSI+出来高+上位足トレンド条件クリア)")
alertcondition(sellSignal, title="売りシグナル発生", message="3分足: 売りシグナル発生 (EMAクロス+VWAP+RSI+出来高+上位足トレンド条件クリア)")
alertcondition(reversalBuySignal, title="反発買いシグナル発生", message="3分足: ストキャスティクス反発買いシグナル発生(売られすぎ圏での交差)")
alertcondition(reversalSellSignal, title="反発売りシグナル発生", message="3分足: ストキャスティクス反発売りシグナル発生(買われすぎ圏での交差)")

// ---------- 参考表示: 現在のRSI値をラベル的に確認したい場合はステータスラインで ----------
plotchar(useRsiFilter ? rsiVal : na, "RSI値(デバッグ用/非表示推奨)", "", location.top, size=size.tiny, color=color.new(color.gray, 100))
