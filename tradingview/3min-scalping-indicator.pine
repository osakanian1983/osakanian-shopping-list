//@version=5
indicator("3分足デイトレ 節目+ローソク足シグナル", shorttitle="3min SR Signal", overlay=true)

// ========================================================
// 3分足デイトレード用 売買タイミング表示インジケーター(シンプル版)
//
// 直近の高値/安値(ピボット)を「節目」としてサポート/レジスタンスの水平線を
// 自動描画し、節目付近でローソク足の反転パターン(包み足・ピンバー/ハンマー・
// 流れ星)が出た足だけをシグナルにする。移動平均線やオシレーターは使わず、
// 節目とローソク足の形そのものを見て判断する、価格アクション主体の方式。
//
// 直近の節目(サポート/レジスタンスそれぞれ1本ずつ)だけを保持するシンプルな
// 構成にしている。ピボット確定には性質上ラグがある(左右の本数分)が、
// パターン自体の検出はリアルタイム。
// ========================================================

grpSr = "節目(サポート/レジスタンス)"
pivotBars = input.int(5, "節目確定に使う左右の本数(ピボット感度)", minval=1, group=grpSr,
     tooltip="小さいほど細かい節目を多く拾う(だまし増)、大きいほど大きな節目だけを拾う(反応は遅れる)。")
proximityAtrMult = input.float(0.5, "節目と見なす近さ(ATRの倍率)", minval=0.1, step=0.1, group=grpSr)
showLines = input.bool(true, "節目のラインをチャートに表示する", group=grpSr)

grpPattern = "ローソク足パターン"
useEngulfing = input.bool(true, "包み足(エンゲルフィング)パターンを使う", group=grpPattern)
usePinbar = input.bool(true, "ピンバー/ハンマー・流れ星パターンを使う", group=grpPattern)
pinbarWickRatio = input.float(0.6, "ピンバーの実体に対するヒゲの最低割合", minval=0.4, maxval=0.9, step=0.05, group=grpPattern)

grpVol = "出来高フィルター"
useVolFilter = input.bool(true, "出来高フィルターを使用する", group=grpVol)
volMaLen = input.int(20, "出来高平均期間", minval=1, group=grpVol)
volMult = input.float(1.0, "出来高がこの倍率以上で採用", minval=0.1, step=0.1, group=grpVol)

// ---------- 節目(サポート/レジスタンス)の検出・管理 ----------
// 直近1本ずつのシンプルな管理(配列は使わない)
atrVal = ta.atr(14)
buffer = atrVal * proximityAtrMult

pivotHigh = ta.pivothigh(high, pivotBars, pivotBars)
pivotLow = ta.pivotlow(low, pivotBars, pivotBars)

var float resLevel = na
var float supLevel = na
var line resLineObj = na
var line supLineObj = na

if not na(pivotHigh)
    resLevel := pivotHigh
    if showLines
        line.delete(resLineObj)
        resLineObj := line.new(bar_index - pivotBars, pivotHigh, bar_index, pivotHigh, extend=extend.right, color=color.new(color.red, 30), style=line.style_dashed, width=1)

if not na(pivotLow)
    supLevel := pivotLow
    if showLines
        line.delete(supLineObj)
        supLineObj := line.new(bar_index - pivotBars, pivotLow, bar_index, pivotLow, extend=extend.right, color=color.new(color.lime, 30), style=line.style_dashed, width=1)

nearSupport = not na(supLevel) and math.abs(low - supLevel) <= buffer
nearResistance = not na(resLevel) and math.abs(high - resLevel) <= buffer

// ---------- 出来高フィルター ----------
volMa = ta.sma(volume, volMaLen)
volOk = not useVolFilter or volume >= volMa * volMult

// ---------- ローソク足の反転パターン ----------
bodySize = math.abs(close - open)
upperWick = high - math.max(close, open)
lowerWick = math.min(close, open) - low
barRange = high - low

bullishEngulfing = useEngulfing and close[1] < open[1] and close > open and close >= open[1] and open <= close[1]
bearishEngulfing = useEngulfing and close[1] > open[1] and close < open and close <= open[1] and open >= close[1]

bullishPinbar = usePinbar and barRange > 0 and lowerWick >= barRange * pinbarWickRatio and upperWick <= barRange * 0.2
bearishPinbar = usePinbar and barRange > 0 and upperWick >= barRange * pinbarWickRatio and lowerWick <= barRange * 0.2

bullishPattern = bullishEngulfing or bullishPinbar
bearishPattern = bearishEngulfing or bearishPinbar

// ---------- シグナル ----------
buySignal = nearSupport and bullishPattern and volOk
sellSignal = nearResistance and bearishPattern and volOk

plotshape(buySignal, title="買いシグナル", style=shape.triangleup, location=location.belowbar,
     color=color.new(color.green, 0), size=size.small, text="買")
plotshape(sellSignal, title="売りシグナル", style=shape.triangledown, location=location.abovebar,
     color=color.new(color.red, 0), size=size.small, text="売")

alertcondition(buySignal, title="買いシグナル発生", message="節目(サポート)付近で強気の反転ローソク足パターン発生")
alertcondition(sellSignal, title="売りシグナル発生", message="節目(レジスタンス)付近で弱気の反転ローソク足パターン発生")
