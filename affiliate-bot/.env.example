# 楽天ウェブサービス(Rakuten Developers で2026年以降に登録したアプリのID)
RAKUTEN_APP_ID=
RAKUTEN_ACCESS_KEY=
RAKUTEN_AFFILIATE_ID=
# アプリの「許可されたWebサイト」に登録したURL(Referer/Origin ヘッダーに使う)
RAKUTEN_REFERER=https://example.com/
# エンドポイントが変わったときだけ上書き
# RAKUTEN_ENDPOINT=https://openapi.rakuten.co.jp/ichibams/api/IchibaItem/Search/20260701

# Claude API
ANTHROPIC_API_KEY=
# CLAUDE_MODEL=claude-opus-5    # 安く済ませるなら claude-sonnet-5
# CLAUDE_EFFORT=medium          # low / medium / high

# WordPress(ユーザー → プロフィール → アプリケーションパスワード で発行)
WP_URL=https://example.com
WP_USER=
WP_APP_PASSWORD=
